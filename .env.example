# Postgres with the pgvector extension (Neon works — free tier, native
# pgvector, built for serverless/Vercel)
DATABASE_URL=postgres://user:password@host:5432/ofin
PGSSL=true

# Groq — used for ask-a-bill (runtime) and summarisation (ingestion), via
# forced tool calls for reliable structured JSON (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Voyage AI — used for embeddings (search + ask-a-bill retrieval)
# Without this, search falls back to a plain ILIKE text match, and ask-a-bill
# falls back to reading a bill's chunks in order instead of by relevance.
VOYAGE_API_KEY=
